{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "dictionaries": ["Repo dictionary"],
  "dictionaryDefinitions": [
    {
      "name": "Repo dictionary",
      "path": "./.dict/repo.dictionary",
    },
  ],
  "files": [
    "**/*.md",
    "**/*.markdown",
    "**/*.txt",
    "**/*.json",
    "**/*.jsonc",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/dist/**",
    "**/.git/**",
    "**/.github/**",
    "**/.cspell/**",
    "**/coverage/**",
    "**/logs/**",
    "**/tmp/**",
    "**/temp/**",
    "**/_site/**",
    ".cspell.jsonc",
    "**/coverage.txt",
    "**/coverage.html",
    "**/*.go",
    "**/Makefile",
    "**/go.mod",
    "**/go.sum",
    "**/htmlcov/**",
    "output/**",
    "config/*.yaml",
  ],
  "ignoreRegExpList": [
    "{%[\\s\\S]*?%}",
    "^---[\\s\\S]*?^---$",
    "^```[\\s\\S]*?^```$",
    "`.*`",
    "\u003ccode\u003e.*\u003c/code\u003e",
    "\u003c!--.*?--\u003e",
    "\u003ca.*?\u003e",
    "\u003cimg.*?\u003e",
    "'.*'",
    "https?://\\S+",
    "\\b[a-zA-Z0-9.-]+\\.[a-zA-Z]{2}(?:/\\S*)?",
  ],
  "import": ["@cspell/dict-da-dk/cspell-ext.json"],
  "language": "en-US, da-DK",
  "languageSettings": [
    {
      "dictionaries": ["Repo dictionary"],
      "languageId": "markdown",
    },
    {
      "dictionaries": ["Repo dictionary"],
      "languageId": "plaintext",
    },
  ],
  "version": "0.2",
}
